NODE_ENV=development
PORT=8082
CONTROL_PLANE_URL=http://localhost:3000
INSTANCE_ID=
RUNNER_SECRET=
HOST_AGENT_SHARED_SECRET=local-agent-shared-secret
CLAWDEPLOY_MODE=true
